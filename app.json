{
  "expo": {
    "name": "Topmeme",
    "slug": "topmeme",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.2.0",
    "sdkVersion": "55.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "systemFonts": [],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.jijascuas.topmeme",
      "versionCode": 7,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "react-native-iap"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
